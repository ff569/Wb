# Токен бота из @BotFather (обязательно)
BOT_TOKEN=1234567890:AAA-your-token-here

# Твои Telegram ID через запятую — владельцы, имеют /stats (обязательно).
# Узнать ID: @userinfobot
ADMIN_IDS=123456789

# На Render подставляется автоматически. Локально не задавай — бот запустится в polling-режиме.
RENDER_EXTERNAL_URL=

# Секрет для проверки запросов вебхука от Telegram (рекомендуется, случайная строка)
WEBHOOK_SECRET=

# Путь вебхука
WEBHOOK_PATH=/webhook

# Файл базы данных SQLite
DB_PATH=wb_detector.db

# Интервал проверки цен, секунды (3600 = раз в час)
CHECK_INTERVAL=3600

# Тарифы
FREE_LIMIT=3
PRO_LIMIT=50
PRO_PRICE_STARS=300
PRO_DAYS=30
DEFAULT_DROP_PCT=5

# Ссылка на поддержку в текстах бота
SUPPORT_URL=https://t.me/your_support_username
